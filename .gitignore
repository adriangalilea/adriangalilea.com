# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# content's media mirrored and link previews drawn by scripts/prepare.mts
/public/*/
# ...except the pictures `pnpm embed` keeps: sources, not copies (Telegram's expire)
!/public/embeds/

# vercel
.vercel

# pnpm 11 regenerates this for build-script approvals; we use package.json's pnpm.onlyBuiltDependencies instead

# typescript
*.tsbuildinfo
next-env.d.ts

# @ag/sealed: committed encrypted beside themselves (scripts/sealed.mts)
/components/ui/github.tsx
/components/ui/telegram-chat-layout.tsx
/components/ui/telegram-chat-scroll.ts
/components/ui/telegram-chat.css
/components/ui/telegram-chat.tsx
/components/ui/tweet.tsx
/lib/github-data.ts
/lib/telegram-chat-framing.ts
/lib/telegram-chat-post.ts
/lib/tweet-data.ts
# end @ag/sealed
